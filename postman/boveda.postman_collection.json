    {
      "name": "3. Flujo del secreto",
      "description": "A crea el secreto; B y C forman el quórum y B lo abre. A es el creador y no cuenta para el quórum. La fecha de apertura es lejana para que solo pueda abrirse por quórum.",
      "item": [
        {
          "name": "A crea un secreto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve el id como string y lo guarda en secretoId', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('string');",
                  "  pm.expect(json).to.not.have.property('_id');",
                  "  pm.collectionVariables.set('secretoId', json.id);",
                  "});",
                  "pm.test('Devuelve titulo y fechaApertura', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.titulo).to.eql('PRUEBA ' + pm.collectionVariables.get('sufijo'));",
                  "  pm.expect(new Date(json.fechaApertura).toISOString()).to.eql('2099-01-01T00:00:00.000Z');",
                  "});",
                  "pm.test('creadoPor sale del token, no del body', () => {",
                  "  pm.expect(pm.response.json().creadoPor).to.eql(Number(pm.collectionVariables.get('idA')));",
                  "});",
                  "pm.test('No devuelve contenido', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('contenido');",
                  "});",
                  "pm.test('No filtra el contenido del secreto', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('Contenido de prueba ' + pm.collectionVariables.get('sufijo'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"PRUEBA {{sufijo}}\",\n  \"contenido\": \"Contenido de prueba {{sufijo}}\",\n  \"fechaApertura\": \"2099-01-01T00:00:00.000Z\",\n  \"creadoPor\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/secretos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "secretos"
              ]
            },
            "description": "El body incluye `creadoPor` a propósito: debe ignorarse y usarse el id del token."
          },
          "response": []
        },
        {
          "name": "Listar secretos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Ningún elemento trae contenido ni solicitudes', () => {",
                  "  const lista = pm.response.json();",
                  "  pm.expect(lista).to.be.an('array');",
                  "  lista.forEach((secreto) => {",
                  "    pm.expect(secreto).to.not.have.property('contenido');",
                  "    pm.expect(secreto).to.not.have.property('solicitudes');",
                  "  });",
                  "});",
                  "pm.test('Incluye el secreto creado, sin solicitudes todavía', () => {",
                  "  const secreto = pm.response.json().find((s) => s.id === pm.collectionVariables.get('secretoId'));",
