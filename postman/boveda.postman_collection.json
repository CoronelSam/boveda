{
  "info": {
    "name": "La Bóveda",
    "description": "Flujo completo de la API de secretos. Córrela completa y en orden con el Collection Runner, con la API levantada. Cada corrida deja 4 cuentas `@prueba.local` y un secreto `PRUEBA ...` en las bases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registro y login",
      "description": "Registra e inicia sesión con los 4 agentes. Cada login guarda su token en una variable de colección.",
      "item": [
        {
          "name": "Registro del agente A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Valor único por corrida: evita que los emails choquen al repetir la colección.",
                  "const sufijo = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
                  "pm.collectionVariables.set('sufijo', sufijo);",
                  "",
                  "// Se limpia la corrida anterior para que un login fallido no reutilice un token viejo.",
                  "['idA', 'tokenA', 'tokenB', 'tokenC', 'tokenD', 'secretoId'].forEach((nombre) => {",
                  "  pm.collectionVariables.set(nombre, '');",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve id, nombre, email y rol de agente', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.expect(json.nombre).to.eql('Agente A');",
                  "  pm.expect(json.email).to.eql('agente-a-' + pm.collectionVariables.get('sufijo') + '@prueba.local');",
                  "  pm.expect(json.rol).to.eql('agente');",
                  "});",
                  "pm.test('No devuelve password', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('password');",
                  "  pm.expect(pm.response.text()).to.not.include('clave-de-prueba-123');",
                  "});",
                  "",
                  "pm.test('Guarda el id de A en idA', () => {",
                  "  const { id } = pm.response.json();",
                  "  pm.expect(id).to.be.a('number');",
                  "  pm.collectionVariables.set('idA', id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Agente A\",\n  \"email\": \"agente-a-{{sufijo}}@prueba.local\",\n  \"password\": \"clave-de-prueba-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "Primer request: define un `sufijo` nuevo para esta corrida y limpia los valores de la anterior."
          },
          "response": []
        },
        {
          "name": "Login del agente A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un token y lo guarda en tokenA', () => {",
                  "  const { token } = pm.response.json();",
                  "  pm.expect(token).to.be.a('string');",
                  "  pm.expect(token.split('.').length).to.eql(3);",
                  "  pm.collectionVariables.set('tokenA', token);",
                  "});",
                  "pm.test('No devuelve password', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('password');",
                  "  pm.expect(pm.response.text()).to.not.include('clave-de-prueba-123');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
